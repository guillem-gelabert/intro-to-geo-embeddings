# GSD planning docs are tracked. The author's global gitignore has
# `*requirements.md` and `*plan.md` rules; re-include the GSD planning
# files those rules would otherwise silently exclude.
!.planning/REQUIREMENTS.md
!.planning/**/*-PLAN.md

# Python / notebooks
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Notebook run artifacts (regenerated by executing notebooks)
outputs/

# OS
.DS_Store
