# GSD planning docs are tracked. The author's global gitignore has
# `*requirements.md` and `*plan.md` rules; re-include the GSD planning
# files those rules would otherwise silently exclude.
!.planning/REQUIREMENTS.md
!.planning/**/*-PLAN.md

# Python / notebooks
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Notebook run artifacts (regenerated by executing notebooks)
outputs/

# Pipeline build cache (pipeline/build.py) -- cached raw AlphaEarth AOI
# windows and any other regenerable intermediate build state; never the
# final frozen tables under data/{area}/, which ARE committed.
data/raw/
data/cache/

# OS
.DS_Store

# Packaging artifacts
dist/
*.egg-info/
.mypy_cache/

# Credential-shaped files (preemptive control per the phase threat model,
# before any credential-adjacent code exists)
.env
.env.*
*-key.json
*service-account*.json
*.pem

# Headless-run artifacts from `make execute-notebooks` (nbclient --output)
notebooks/**/executed_*.ipynb

# Rendered slide-deck build output (`make slides` / `make slides-pdf`);
# sources are the tracked slides/*.md files, HTML/PDF are regenerable.
slides/*.html
slides/*.pdf
slides/pdf/
